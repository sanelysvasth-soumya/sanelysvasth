---
layout: layouts/base.njk
permalink: /contact/
title: Contact
description: Get in touch with Svasth by Soumya for consultations, queries or appointments. Based in Bengaluru, India.
pageScripts: ["contact"]
pageTitle: "Get in Touch"
eyebrow: "Say hello"
lede: "Reach out for queries, appointments, or just to say hello."
---

{# Contact channels lifted out of the form column and given equal weight —
   most visitors want to message on WhatsApp, not fill in a form. #}
<div class="container">
  <ul class="contact-channels">
    <li class="contact-channel">
      <span class="contact-channel__icon">{% set icon = "chat" %}{% include "components/icon.njk" %}</span>
      <div>
        <h2 class="contact-channel__label">WhatsApp</h2>
        <a class="contact-channel__value" href="{{ site.contact.whatsapp }}"
           target="_blank" rel="noopener noreferrer">Message directly</a>
      </div>
    </li>
    <li class="contact-channel">
      <span class="contact-channel__icon">{% set icon = "phone" %}{% include "components/icon.njk" %}</span>
      <div>
        <h2 class="contact-channel__label">Phone</h2>
        <a class="contact-channel__value" href="tel:{{ site.contact.phoneHref }}">{{ site.contact.phoneDisplay }}</a>
      </div>
    </li>
    <li class="contact-channel">
      <span class="contact-channel__icon">{% set icon = "envelope" %}{% include "components/icon.njk" %}</span>
      <div>
        <h2 class="contact-channel__label">Email</h2>
        <a class="contact-channel__value" href="mailto:{{ site.contact.emailHref }}">{{ site.contact.emailDisplay }}</a>
      </div>
    </li>
    <li class="contact-channel">
      <span class="contact-channel__icon">{% set icon = "pin" %}{% include "components/icon.njk" %}</span>
      <div>
        <h2 class="contact-channel__label">Location</h2>
        <p class="contact-channel__value">{{ site.contact.location }}</p>
      </div>
    </li>
  </ul>
</div>

<div class="section">
  <div class="container container--narrow">
    <div class="calculator__panel">
      <h2 class="calculator__panel-title">Send a message</h2>

      <form id="contactForm" novalidate>
        <div class="form-summary" data-form-summary role="alert" aria-live="assertive"></div>

        <div class="field">
          <label class="field__label" for="cf-name">Name<span class="required" aria-hidden="true">*</span></label>
          <input class="control" id="cf-name" name="Name" type="text" autocomplete="name"
                 aria-describedby="cf-name-error">
          <span class="field__error" id="cf-name-error"></span>
        </div>

        <div class="field">
          <label class="field__label" for="cf-contact">Contact number (WhatsApp)<span class="required" aria-hidden="true">*</span></label>
          <input class="control" id="cf-contact" name="Contact" type="tel" inputmode="tel" autocomplete="tel"
                 aria-describedby="cf-contact-hint cf-contact-error">
          <span class="field__hint" id="cf-contact-hint">So we can reply on WhatsApp.</span>
          <span class="field__error" id="cf-contact-error"></span>
        </div>

        <div class="field">
          <label class="field__label" for="cf-subject">Subject<span class="required" aria-hidden="true">*</span></label>
          <input class="control" id="cf-subject" name="Subject" type="text"
                 aria-describedby="cf-subject-error">
          <span class="field__error" id="cf-subject-error"></span>
        </div>

        <div class="field">
          <label class="field__label" for="cf-message">Message<span class="required" aria-hidden="true">*</span></label>
          <textarea class="control" id="cf-message" name="Message" rows="6" maxlength="1500"
                    aria-describedby="cf-message-error"></textarea>
          <span class="char-counter" data-char-counter="cf-message">0 / 1500</span>
          <span class="field__error" id="cf-message-error"></span>
        </div>

        <div class="calculator__actions">
          <button type="submit" class="btn btn--primary btn--block" id="submitBtn"
                  data-label="Send message">Send message</button>
        </div>
      </form>

      {# Success state replaces the form rather than appearing beneath it #}
      <div class="form-success" id="formStatus" hidden role="status" aria-live="polite">
        <span class="form-success__icon" aria-hidden="true">✓</span>
        <h2 class="form-success__title">Message sent</h2>
        <p class="form-success__text">
          Thanks for reaching out — we'll get back to you on WhatsApp shortly.
        </p>
        <button type="button" class="btn btn--secondary" data-send-another>Send another message</button>
      </div>
    </div>

    <p class="text-center" style="margin-top: var(--space-lg); color: var(--color-text-muted); font-size: var(--text-sm)">
      Prefer WhatsApp? <a href="{{ site.contact.whatsapp }}" target="_blank" rel="noopener noreferrer">Message us directly</a>.
    </p>
  </div>
</div>
