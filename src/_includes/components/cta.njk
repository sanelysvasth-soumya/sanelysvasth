{# Shared consultation CTA. Replaces the block that add_cta.py injected
   into blog posts via regex — now one component, one place to change. #}
<aside class="cta-panel no-print">
  <div>
    <h2 class="cta-panel__title">Ready to take the next step?</h2>
    <p class="cta-panel__text">
      Get a plan built around your physiology, routine and goals.
    </p>
  </div>
  <a class="btn btn--primary" href="{{ site.contact.whatsapp }}"
     target="_blank" rel="noopener noreferrer">
    Book a consultation
  </a>
</aside>
